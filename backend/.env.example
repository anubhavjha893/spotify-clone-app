PORT=5000
NODE_ENV=development
# Local dev: mongodb://127.0.0.1:27017/spotify-clone
# Production: a MongoDB Atlas connection string (Render cannot reach a database on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/spotify-clone
# Comma separated list of origins allowed to call the API, e.g.
# http://localhost:3000,https://looma.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:3000
# Email of the account that can open the admin dashboard (must be verified in Clerk)
ADMIN_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
